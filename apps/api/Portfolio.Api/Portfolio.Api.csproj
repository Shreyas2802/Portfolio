<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UserSecretsId>portfolio-api-dev-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Portfolio.Application\Portfolio.Application.csproj" />
    <ProjectReference Include="..\Portfolio.Infrastructure\Portfolio.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Design-time tooling for `dotnet ef`. Lives in the startup
      project (this one) by convention rather than in Infrastructure,
      which is where the actual DbContext lives. dotnet-ef is pointed
      at both via the project and startup-project flags.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
  </ItemGroup>

  <!--
    Baked into the generated web.config's <aspNetCore><environmentVariables>
    section on every `dotnet publish` - survives republishing without any
    manual post-publish editing. Only the environment NAME goes here
    (never a secret) - the actual connection string, JWT key, and admin
    credentials are set via Plesk's own environment-variable
    configuration for the site, never committed to this file. See
    docs/deployment/plesk-deployment-guide.md.
  -->
  <ItemGroup>
    <EnvironmentVariables Include="ASPNETCORE_ENVIRONMENT" Value="Production" />
  </ItemGroup>

</Project>
