<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UserSecretsId>portfolio-api-dev-secrets</UserSecretsId>
    <!--
      These two properties inject directly into the generated web.config
      on every `dotnet publish` — no manual post-publish editing needed.
      ASPNETCORE_ENVIRONMENT=Production ensures the app never runs in
      Development mode on the server (no dev exception pages, no DB seed).
      Stdout logging on so IIS/ANCM captures app logs next to the dll.
    -->
    <EnvironmentName>Production</EnvironmentName>
    <AspNetCoreHostingModel>inprocess</AspNetCoreHostingModel>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Portfolio.Application\Portfolio.Application.csproj" />
    <ProjectReference Include="..\Portfolio.Infrastructure\Portfolio.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Design-time tooling for `dotnet ef`. Lives in the startup
      project (this one) by convention rather than in Infrastructure,
      which is where the actual DbContext lives. dotnet-ef is pointed
      at both via the project and startup-project flags.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
  </ItemGroup>

  <!--
    Injects ASPNETCORE_ENVIRONMENT into the published web.config's
    <environmentVariables> block. The <EnvironmentVariables> item group
    syntax below is the correct form for Microsoft.NET.Sdk.Web (net9).
    Combined with the fixed web.config in the repo root (which serves
    as a template/fallback), this ensures Production environment on
    every redeploy without manual intervention.
  -->
  <ItemGroup>
    <EnvironmentVariables Include="ASPNETCORE_ENVIRONMENT" Value="Production" />
  </ItemGroup>

</Project>
